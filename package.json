{
  "name": "bugs-in-the-box",
  "version": "0.1.0",
  "private": true,
  "description": "Turn-based 3D artillery game in the browser: bugs inside devices, destructible terrain (SDF).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench.ts",
    "golden": "tsx scripts/golden.ts",
    "balance": "tsx scripts/balance.ts",
    "crosscheck": "tsx scripts/crosscheck.ts"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
